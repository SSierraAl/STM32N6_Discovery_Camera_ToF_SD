1207:Src/main.c    ****                             tskIDLE_PRIORITY + 2,
1208:Src/main.c    ****                             storage_thread_stack, &storage_thread_cb);
1209:Src/main.c    ****     assert(hdl != NULL);
1210:Src/main.c    **** 
1211:Src/main.c    ****     /* ---- Camera task (acquisition, high priority for fast snaps) ---- */
1212:Src/main.c    ****     hdl = xTaskCreateStatic(camera_task, "camera",
1213:Src/main.c    ****                             CAMERA_TASK_STACK_SIZE, NULL,
1214:Src/main.c    ****                             tskIDLE_PRIORITY + 3,
1215:Src/main.c    ****                             camera_thread_stack, &camera_thread_cb);
1216:Src/main.c    ****     assert(hdl != NULL);
1217:Src/main.c    **** #else
1218:Src/main.c    ****     (void)storage_thread_stack;
1219:Src/main.c    ****     (void)storage_thread_cb;
1220:Src/main.c    ****     (void)camera_thread_stack;
1221:Src/main.c    ****     (void)camera_thread_cb;
1222:Src/main.c    **** #endif
1223:Src/main.c    **** 
1224:Src/main.c    ****     /* ---- Sensor task (ToF monitoring, highest priority for detection) ----
1225:Src/main.c    ****        Not needed in ON-DEMAND mode (CAPTURE_MODE=0): capture is triggered
1226:Src/main.c    ****        purely by the USER button via btn_thread, ToF stays fully off. */
