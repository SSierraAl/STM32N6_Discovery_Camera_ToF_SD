1197:Src/main.c    ****                             configMINIMAL_STACK_SIZE, NULL,
1198:Src/main.c    ****                             tskIDLE_PRIORITY + 1,
1199:Src/main.c    ****                             main_thread_stack, &main_thread_cb);
1200:Src/main.c    ****     assert(hdl != NULL);
1201:Src/main.c    **** 
1202:Src/main.c    ****     /* ---- Storage and camera tasks are not needed for the ToF-only test. ---- */
1203:Src/main.c    **** #if !TEST_TOF_MODE
1204:Src/main.c    ****     /* ---- Storage task (blocking SD writes) ---- */
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccXjqF6n.s 			page 55


