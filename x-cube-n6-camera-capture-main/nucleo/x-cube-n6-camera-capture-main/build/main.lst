 643:Src/main.c    ****                      "[ETH] PHY found at addr 0x%02lX  BMCR=0x%04lX  -> powering down\n",
 644:Src/main.c    ****                      (unsigned long)phy_tbl[i], (unsigned long)reg);
 645:Src/main.c    ****             ETH_PD_WritePHYReg(eth, phy_tbl[i], ETH_PD_BMCR_REG, reg | ETH_PD_BMCR_PDN);
 646:Src/main.c    ****             found = 1;
 647:Src/main.c    ****             break;
 648:Src/main.c    ****         }
 649:Src/main.c    ****     }
 650:Src/main.c    ****     /* Fallback: try reading PHY ID register (reg 2 = PHY ID1) at addr 0x00
 651:Src/main.c    ****        RTL8211F PHY ID1 = 0x001C */
 652:Src/main.c    ****     if (!found)
 653:Src/main.c    ****     {
 654:Src/main.c    ****         uint32_t id = ETH_PD_ReadPHYReg(eth, 0x00U, 0x02U);
 655:Src/main.c    ****         if (id != 0xFFFFFFFFU && id != 0x0000U)
 656:Src/main.c    ****         {
 657:Src/main.c    ****             LP_PRINT(LP_TRACE_ETH_POWERDOWN,
 658:Src/main.c    ****                      "[ETH] PHY found via ID reg at addr 0x00  ID=0x%04lX  -> powering down\n",
 659:Src/main.c    ****                      (unsigned long)id);
 660:Src/main.c    ****             /* Read BMCR again and force power-down */
 661:Src/main.c    ****             uint32_t bmcr = ETH_PD_ReadPHYReg(eth, 0x00U, ETH_PD_BMCR_REG);
 662:Src/main.c    ****             ETH_PD_WritePHYReg(eth, 0x00U, ETH_PD_BMCR_REG, bmcr | ETH_PD_BMCR_PDN);
 663:Src/main.c    ****             found = 1;
 664:Src/main.c    ****         }
 665:Src/main.c    ****     }
 666:Src/main.c    ****     if (!found)
 667:Src/main.c    ****         LP_PRINT(LP_TRACE_ETH_POWERDOWN, "[ETH] WARNING: No PHY responded on MDIO bus!\n");
