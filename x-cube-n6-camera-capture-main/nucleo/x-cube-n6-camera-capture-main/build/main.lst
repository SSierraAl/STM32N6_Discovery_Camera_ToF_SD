 308:Src/main.c    **** /**
 309:Src/main.c    ****  * @brief  Configure Memory Protection Unit
 310:Src/main.c    ****  *
 311:Src/main.c    ****  *         Sets up a non-cacheable region for the .uncached_bss section
 312:Src/main.c    ****  *         to ensure proper access for peripherals that require it.
 313:Src/main.c    ****  */
 314:Src/main.c    **** static void Setup_Mpu(void)
 315:Src/main.c    **** {
 316:Src/main.c    ****     MPU_Attributes_InitTypeDef attr;
 317:Src/main.c    ****     MPU_Region_InitTypeDef     region;
 318:Src/main.c    **** 
 319:Src/main.c    ****     /* Configure non-cacheable memory attribute */
 320:Src/main.c    ****     attr.Number     = MPU_ATTRIBUTES_NUMBER0;
 321:Src/main.c    ****     attr.Attributes = MPU_NOT_CACHEABLE;
 322:Src/main.c    ****     HAL_MPU_ConfigMemoryAttributes(&attr);
 323:Src/main.c    **** 
 324:Src/main.c    ****     /* Map attribute to .uncached_bss region */
 325:Src/main.c    ****     region.Enable           = MPU_REGION_ENABLE;
 326:Src/main.c    ****     region.Number           = MPU_REGION_NUMBER0;
 327:Src/main.c    ****     region.BaseAddress      = (uint32_t)&__uncached_bss_start__;
 328:Src/main.c    ****     region.LimitAddress     = (uint32_t)&__uncached_bss_end__ - 1;
 329:Src/main.c    ****     region.AttributesIndex  = MPU_ATTRIBUTES_NUMBER0;
 330:Src/main.c    ****     region.AccessPermission = MPU_REGION_ALL_RW;
 331:Src/main.c    ****     region.DisableExec      = MPU_INSTRUCTION_ACCESS_ENABLE;
 332:Src/main.c    ****     region.DisablePrivExec  = MPU_PRIV_INSTRUCTION_ACCESS_ENABLE;
 333:Src/main.c    ****     region.IsShareable      = MPU_ACCESS_NOT_SHAREABLE;
 334:Src/main.c    ****     HAL_MPU_ConfigRegion(&region);
 335:Src/main.c    ****     HAL_MPU_Enable(MPU_PRIVILEGED_DEFAULT);
 336:Src/main.c    ****     memset(&__uncached_bss_start__, 0, &__uncached_bss_end__ - &__uncached_bss_start__);
 337:Src/main.c    **** }
