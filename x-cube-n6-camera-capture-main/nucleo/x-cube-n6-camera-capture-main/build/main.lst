 509:Src/main.c    **** /* ================================================================
 510:Src/main.c    ****    SECTION 10.5: ETHERNET FULL POWER-DOWN (RGMII PHY + GPIO + CLOCK)
 511:Src/main.c    ****    ================================================================ 
 512:Src/main.c    **** 
 513:Src/main.c    ****    Powers down the RTL8211F Ethernet PHY and disables all associated
 514:Src/main.c    ****    GPIO + clock resources.  Strategy:
 515:Src/main.c    ****      1. Configure ETH1 main clock source to PLL2_P (IC6=125MHz, already on)
 516:Src/main.c    ****      2. Enable all ETH1 AHB clocks for MDIO bus access
 517:Src/main.c    ****      3. Temporarily configure MDIO (PA4) + MDC (PC1) as AF11
 518:Src/main.c    ****      4. Try multiple PHY addresses to find the RTL8211F
 519:Src/main.c    ****      5. Set IEEE 802.3 BMCR Power-Down bit (bit 11) on the PHY
 520:Src/main.c    ****      6. Set ALL Ethernet RGMII GPIO -> ANALOG (High-Z, no pull)
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccXjqF6n.s 			page 43


 521:Src/main.c    ****      7. Disable all ETH1 clocks
 522:Src/main.c    ****    ================================================================ */
 523:Src/main.c    **** 
 524:Src/main.c    **** #define ETH_PD_BMCR_REG    0x00U           /* Basic Mode Control Register */
 525:Src/main.c    **** #define ETH_PD_BMCR_PDN    (1UL << 11)     /* Power Down bit */
 526:Src/main.c    **** 
 527:Src/main.c    **** /* MDIO register helpers (direct reg access; HAL_ETH not compiled here) */
 528:Src/main.c    **** static void ETH_PD_SetMDIOClockRange(ETH_TypeDef *eth)
 529:Src/main.c    **** {
 530:Src/main.c    ****     uint32_t hclk = HAL_RCC_GetHCLKFreq();
 531:Src/main.c    ****     uint32_t tmp = eth->MACMDIOAR;
 532:Src/main.c    ****     tmp &= ~ETH_MACMDIOAR_CR;
 533:Src/main.c    ****     if      (hclk < 35000000U)   tmp |= ETH_MACMDIOAR_CR_DIV16;
 534:Src/main.c    ****     else if (hclk < 60000000U)   tmp |= ETH_MACMDIOAR_CR_DIV26;
 535:Src/main.c    ****     else if (hclk < 100000000U)  tmp |= ETH_MACMDIOAR_CR_DIV42;
 536:Src/main.c    ****     else if (hclk < 150000000U)  tmp |= ETH_MACMDIOAR_CR_DIV62;
 537:Src/main.c    ****     else if (hclk < 250000000U)  tmp |= ETH_MACMDIOAR_CR_DIV102;
 538:Src/main.c    ****     else if (hclk < 300000000U)  tmp |= ETH_MACMDIOAR_CR_DIV124;
 539:Src/main.c    ****     else                         tmp |= ETH_MACMDIOAR_CR_DIV204;
 540:Src/main.c    ****     eth->MACMDIOAR = tmp;
 541:Src/main.c    **** }
 542:Src/main.c    **** 
 543:Src/main.c    **** static uint32_t ETH_PD_ReadPHYReg(ETH_TypeDef *eth, uint32_t phy_addr, uint32_t reg_addr)
 544:Src/main.c    **** {
 545:Src/main.c    ****     uint32_t tickstart;
 546:Src/main.c    ****     uint32_t tmpreg;
 547:Src/main.c    ****     if (READ_BIT(eth->MACMDIOAR, ETH_MACMDIOAR_GB) != 0U)
 548:Src/main.c    ****         return 0xFFFFFFFFU;
 549:Src/main.c    ****     tmpreg = eth->MACMDIOAR;
 550:Src/main.c    ****     MODIFY_REG(tmpreg, ETH_MACMDIOAR_PA, (phy_addr << 21));
 551:Src/main.c    ****     MODIFY_REG(tmpreg, ETH_MACMDIOAR_RDA, (reg_addr << 16));
 552:Src/main.c    ****     MODIFY_REG(tmpreg, ETH_MACMDIOAR_GOC, (ETH_MACMDIOAR_GOC_1 | ETH_MACMDIOAR_GOC_0));
 553:Src/main.c    ****     SET_BIT(tmpreg, ETH_MACMDIOAR_GB);
 554:Src/main.c    ****     eth->MACMDIOAR = tmpreg;
 555:Src/main.c    ****     tickstart = HAL_GetTick();
 556:Src/main.c    ****     while (READ_BIT(eth->MACMDIOAR, ETH_MACMDIOAR_GB) != 0U)
 557:Src/main.c    ****     {
 558:Src/main.c    ****         if ((HAL_GetTick() - tickstart) > 1000U)
 559:Src/main.c    ****             return 0xFFFFFFFFU;
 560:Src/main.c    ****     }
 561:Src/main.c    ****     return (uint32_t)(uint16_t)eth->MACMDIODR;
 562:Src/main.c    **** }
 563:Src/main.c    **** 
 564:Src/main.c    **** static void ETH_PD_WritePHYReg(ETH_TypeDef *eth, uint32_t phy_addr, uint32_t reg_addr, uint32_t val
 565:Src/main.c    **** {
 566:Src/main.c    ****     uint32_t tickstart;
 567:Src/main.c    ****     uint32_t tmpreg;
 568:Src/main.c    ****     if (READ_BIT(eth->MACMDIOAR, ETH_MACMDIOAR_GB) != 0U)
 569:Src/main.c    ****         return;
 570:Src/main.c    ****     tmpreg = eth->MACMDIOAR;
 571:Src/main.c    ****     MODIFY_REG(tmpreg, ETH_MACMDIOAR_PA, (phy_addr << 21));
 572:Src/main.c    ****     MODIFY_REG(tmpreg, ETH_MACMDIOAR_RDA, (reg_addr << 16));
 573:Src/main.c    ****     MODIFY_REG(tmpreg, ETH_MACMDIOAR_GOC, ETH_MACMDIOAR_GOC_0);
 574:Src/main.c    ****     SET_BIT(tmpreg, ETH_MACMDIOAR_GB);
 575:Src/main.c    ****     WRITE_REG(eth->MACMDIODR, (uint16_t)value);
 576:Src/main.c    ****     tickstart = HAL_GetTick();
 577:Src/main.c    ****     while (READ_BIT(eth->MACMDIOAR, ETH_MACMDIOAR_GB) != 0U)
