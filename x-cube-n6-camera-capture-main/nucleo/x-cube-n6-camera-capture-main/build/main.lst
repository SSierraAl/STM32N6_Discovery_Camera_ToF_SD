1173:Src/main.c    **** /**
1174:Src/main.c    ****  * @brief  Create and start FreeRTOS tasks
1175:Src/main.c    ****  *
1176:Src/main.c    ****  *         Tasks created:
1177:Src/main.c    ****  *         - main_thread   (priority IDLE+1): Board init, then deletes itself
1178:Src/main.c    ****  *         - storage_task  (priority IDLE+2): SD card writes (blocking OK)
1179:Src/main.c    ****  *         - camera_task   (priority IDLE+3): Camera acquisition (fast response)
1180:Src/main.c    ****  *         - sensor_task   (priority IDLE+4): ToF monitoring (highest, detection critical)
1181:Src/main.c    ****  *         - btn_thread    (priority IDLE+3): Button polling + manual capture
1182:Src/main.c    ****  */
1183:Src/main.c    **** static int main_freertos(void)
1184:Src/main.c    **** {
1185:Src/main.c    ****     TaskHandle_t hdl;
1186:Src/main.c    **** 
1187:Src/main.c    ****     /* Create the I2C1 arbiter mutex BEFORE any task starts. The camera
1188:Src/main.c    ****        (BSP_I2C1_*) and the VL53L5CX ToF sensor (raw hi2c1 in platform.c)
1189:Src/main.c    ****        are two independent HAL handles driving the same physical I2C1 bus;
1190:Src/main.c    ****        without this mutex, concurrent use (e.g. CAPTURE_MODE=1's continuous
1191:Src/main.c    ****        ISP servicing running alongside the ToF ranging loop) can corrupt
1192:Src/main.c    ****        the bus protocol. See i2c_arbiter.h. */
