 865:Src/main.c    **** /**
 866:Src/main.c    ****  * @brief  Store a raw image frame to SD card with header metadata
 867:Src/main.c    ****  *
 868:Src/main.c    ****  *         Uses batched writes (SD_BATCH_WRITE_BLOCKS per HAL call) for
 869:Src/main.c    ****  *         much faster throughput than single-block writes.
 870:Src/main.c    ****  *
 871:Src/main.c    ****  * @param  img_buf       Pointer to image data buffer
 872:Src/main.c    ****  * @param  img_size      Size of image data in bytes
 873:Src/main.c    ****  * @param  w             Image width in pixels
 874:Src/main.c    ****  * @param  h             Image height in pixels
 875:Src/main.c    ****  * @param  pixel_format  Pixel format identifier
 876:Src/main.c    ****  * @return 0 on success, -1 on failure
 877:Src/main.c    ****  */
 878:Src/main.c    **** static int SD_StoreRawImage(const uint8_t *img_buf, uint32_t img_size,
 879:Src/main.c    ****                             uint32_t w, uint32_t h, uint32_t pixel_format)
 880:Src/main.c    **** {
 881:Src/main.c    ****     uint32_t         base = SD_IMG_BASE_BLOCK;
 882:Src/main.c    ****     uint32_t         total_blocks = (SD_IMG_HEADER_SIZE + img_size + SD_BLOCK_SIZE - 1) / SD_BLOCK_
 883:Src/main.c    ****     uint32_t         i, checksum = 0;
 884:Src/main.c    **** 
 885:Src/main.c    ****     /* ---- Overflow protection: check if this snapshot fits on the card ---- */
 886:Src/main.c    ****     if (hsd1.SdCard.BlockNbr > 0) {
 887:Src/main.c    ****         uint32_t last_block = base + total_blocks - 1;
 888:Src/main.c    ****         if (last_block >= hsd1.SdCard.BlockNbr) {
 889:Src/main.c    ****             printf("[SD Store] OVERFLOW! block %lu >= card max %lu\n",
 890:Src/main.c    ****                    (unsigned long)last_block, (unsigned long)hsd1.SdCard.BlockNbr);
 891:Src/main.c    ****             return -1;
 892:Src/main.c    ****         }
 893:Src/main.c    ****     }
 894:Src/main.c    **** 
 895:Src/main.c    ****     /* Compute XOR checksum of image data */
 896:Src/main.c    ****     for (i = 0; i < img_size; i++)
 897:Src/main.c    ****         checksum ^= img_buf[i];
 898:Src/main.c    **** 
 899:Src/main.c    ****     /* Build image header */
 900:Src/main.c    ****     sd_image_header_t hdr = {0};
 901:Src/main.c    ****     hdr.magic        = SD_HEADER_TAG;
 902:Src/main.c    ****     hdr.width        = w;
 903:Src/main.c    ****     hdr.height       = h;
 904:Src/main.c    ****     hdr.pixel_format = pixel_format;
 905:Src/main.c    ****     hdr.data_size    = img_size;
 906:Src/main.c    ****     RawImage_SetStamp(&hdr, button_stamp);
 907:Src/main.c    ****     hdr.checksum     = checksum;
 908:Src/main.c    ****     hdr.snap_id      = snap_count;
 909:Src/main.c    ****     memset(hdr.reserved, 0, sizeof(hdr.reserved));
 910:Src/main.c    **** 
 911:Src/main.c    ****     /* ---- Use the PSRAM batch buffer (sd_batch_buf) for all writes ---- */
 912:Src/main.c    ****     uint32_t batch_size = SD_BATCH_WRITE_BLOCKS * SD_BLOCK_SIZE;
 913:Src/main.c    **** 
 914:Src/main.c    ****     printf("\n[SD Store] %lux%lu fmt=%lu  %lu bytes  %lu blocks  (batch=%lu blocks/call)\n",
 915:Src/main.c    ****            (unsigned long)w, (unsigned long)h, pixel_format,
 916:Src/main.c    ****            img_size, total_blocks, (unsigned long)SD_BATCH_WRITE_BLOCKS);
 917:Src/main.c    **** 
 918:Src/main.c    ****     /* --- Step 1: Write header block (block 0 of this snapshot) ---
 919:Src/main.c    ****        The header is 64 bytes at offset 0; image data starts at offset 64.
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccXjqF6n.s 			page 50


 920:Src/main.c    ****        Fill the rest of the first block with image data, then pad
 921:Src/main.c    ****        remaining batch slots with zeros. */
 922:Src/main.c    ****     memset(sd_batch_buf, 0, batch_size);
 923:Src/main.c    ****     memcpy(sd_batch_buf, &hdr, SD_IMG_HEADER_SIZE);
 924:Src/main.c    ****     uint32_t first_chunk = SD_BLOCK_SIZE - SD_IMG_HEADER_SIZE;
 925:Src/main.c    ****     if (first_chunk > img_size) first_chunk = img_size;
 926:Src/main.c    ****     memcpy(sd_batch_buf + SD_IMG_HEADER_SIZE, img_buf, first_chunk);
 927:Src/main.c    **** 
 928:Src/main.c    ****     /* If image has more data, also pre-fill batch slots 2..N */
 929:Src/main.c    ****     uint32_t img_offset = first_chunk;          /* bytes of image already in block 0 */
 930:Src/main.c    ****     uint32_t batch_blk  = 1;                    /* next block index within batch (0 = header) */
 931:Src/main.c    ****     while (img_offset < img_size && batch_blk < SD_BATCH_WRITE_BLOCKS) {
 932:Src/main.c    ****         uint32_t chunk = SD_BLOCK_SIZE;
 933:Src/main.c    ****         if (chunk > img_size - img_offset) chunk = img_size - img_offset;
 934:Src/main.c    ****         memcpy(sd_batch_buf + batch_blk * SD_BLOCK_SIZE, img_buf + img_offset, chunk);
 935:Src/main.c    ****         if (chunk < SD_BLOCK_SIZE)
 936:Src/main.c    ****             memset(sd_batch_buf + batch_blk * SD_BLOCK_SIZE + chunk, 0, SD_BLOCK_SIZE - chunk);
 937:Src/main.c    ****         img_offset += chunk;
 938:Src/main.c    ****         batch_blk++;
 939:Src/main.c    ****     }
 940:Src/main.c    **** 
 941:Src/main.c    ****     /* Write however many blocks we filled (at least 1 for the header) */
 942:Src/main.c    ****     uint32_t blocks_to_write = batch_blk;
 943:Src/main.c    **** 
 944:Src/main.c    ****     /* Clean D-Cache so SD controller DMA sees the actual data in sd_batch_buf */
 945:Src/main.c    ****     SCB_CleanDCache_by_Addr((uint32_t *)sd_batch_buf, blocks_to_write * SD_BLOCK_SIZE);
 946:Src/main.c    **** 
 947:Src/main.c    ****     HAL_StatusTypeDef st = HAL_SD_WriteBlocks(&hsd1, sd_batch_buf, base, blocks_to_write, HAL_MAX_D
 948:Src/main.c    ****     if (st != HAL_OK) {
 949:Src/main.c    ****         printf("[SD Store] header batch FAIL (blocks %lu..%lu)\n",
 950:Src/main.c    ****                (unsigned long)base, (unsigned long)(base + blocks_to_write - 1));
 951:Src/main.c    ****         return -1;
 952:Src/main.c    ****     }
 953:Src/main.c    **** 
 954:Src/main.c    ****     uint32_t current_block = base + blocks_to_write;
 955:Src/main.c    **** 
 956:Src/main.c    ****     /* --- Step 2: Write remaining image data in full batches --- */
 957:Src/main.c    ****     while (img_offset < img_size) {
 958:Src/main.c    ****         uint32_t remaining_bytes = img_size - img_offset;
 959:Src/main.c    ****         uint32_t remaining_blocks_full = (remaining_bytes + SD_BLOCK_SIZE - 1) / SD_BLOCK_SIZE;
 960:Src/main.c    ****         uint32_t blocks_in_batch = (remaining_blocks_full < SD_BATCH_WRITE_BLOCKS)
 961:Src/main.c    ****                                     ? remaining_blocks_full : SD_BATCH_WRITE_BLOCKS;
 962:Src/main.c    **** 
 963:Src/main.c    ****         /* Fill the batch buffer */
 964:Src/main.c    ****         for (uint32_t b = 0; b < blocks_in_batch; b++) {
 965:Src/main.c    ****             uint32_t src = img_offset + b * SD_BLOCK_SIZE;
 966:Src/main.c    ****             uint32_t dst = b * SD_BLOCK_SIZE;
 967:Src/main.c    ****             if (src + SD_BLOCK_SIZE <= img_size) {
 968:Src/main.c    ****                 /* Full block — direct copy */
 969:Src/main.c    ****                 memcpy(sd_batch_buf + dst, img_buf + src, SD_BLOCK_SIZE);
 970:Src/main.c    ****             } else {
 971:Src/main.c    ****                 /* Last block — copy partial + zero-pad */
 972:Src/main.c    ****                 uint32_t partial = img_size - src;
 973:Src/main.c    ****                 memcpy(sd_batch_buf + dst, img_buf + src, partial);
 974:Src/main.c    ****                 memset(sd_batch_buf + dst + partial, 0, SD_BLOCK_SIZE - partial);
 975:Src/main.c    ****             }
 976:Src/main.c    ****         }
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccXjqF6n.s 			page 51


 977:Src/main.c    **** 
 978:Src/main.c    ****         /* Wait for SD card to be ready before next batch.
 979:Src/main.c    ****            SDXC cards (128GB+) need significant time between multi-block write
 980:Src/main.c    ****            operations to complete internal flash programming. A tight loop is
 981:Src/main.c    ****            insufficient — we use TaskYIELD to let the SDMMC interrupt handler
 982:Src/main.c    ****            process and update the card state machine. */
 983:Src/main.c    ****         {
 984:Src/main.c    ****             uint32_t wait_ms = 0;
 985:Src/main.c    ****             while (HAL_SD_GetCardState(&hsd1) != HAL_SD_CARD_TRANSFER && wait_ms < 500) {
 986:Src/main.c    ****                 vTaskDelay(1);   /* 1 tick = 10 ms with configTICK_RATE_HZ=100 */
 987:Src/main.c    ****                 wait_ms++;
 988:Src/main.c    ****             }
 989:Src/main.c    ****             if (wait_ms >= 5000) {
 990:Src/main.c    ****                 printf("[SD Store] Card timeout before block %lu (state=%lu after %lu ms)\n",
 991:Src/main.c    ****                        (unsigned long)current_block,
 992:Src/main.c    ****                        (unsigned long)HAL_SD_GetCardState(&hsd1),
 993:Src/main.c    ****                        (unsigned long)wait_ms);
 994:Src/main.c    ****             }
 995:Src/main.c    ****         }
 996:Src/main.c    **** 
 997:Src/main.c    ****         /* Clean D-Cache so SD controller DMA sees fresh data */
 998:Src/main.c    ****         SCB_CleanDCache_by_Addr((uint32_t *)sd_batch_buf, blocks_in_batch * SD_BLOCK_SIZE);
 999:Src/main.c    **** 
1000:Src/main.c    ****         /* Minimum inter-batch recovery gap for SD card internal NAND flash
1001:Src/main.c    ****            programming. The card's CMD13 status may say "ready" but the physical
1002:Src/main.c    ****            flash still needs time to complete erase/program cycles. Without this
1003:Src/main.c    ****            15ms gap, STA=0x5000 (Data Command Response Timeout) occurs on many
1004:Src/main.c    ****            SDXC cards when sending the next write command too quickly.
1005:Src/main.c    ****            Configurable via SD_BATCH_RECOVERY_GAP_MS in app_config.h. */
1006:Src/main.c    ****         vTaskDelay(pdMS_TO_TICKS(SD_BATCH_RECOVERY_GAP_MS));
1007:Src/main.c    **** 
1008:Src/main.c    ****         st = HAL_SD_WriteBlocks(&hsd1, sd_batch_buf, current_block, blocks_in_batch, HAL_MAX_DELAY)
1009:Src/main.c    ****         if (st != HAL_OK) {
1010:Src/main.c    ****             printf("[SD Store] batch FAIL at block %lu (HAL=0x%08lX STA=0x%08lX)\n",
1011:Src/main.c    ****                    (unsigned long)current_block, (unsigned long)st, (unsigned long)SDMMC2->STA);
1012:Src/main.c    ****             return -1;
1013:Src/main.c    ****         }
1014:Src/main.c    **** 
1015:Src/main.c    ****         img_offset += blocks_in_batch * SD_BLOCK_SIZE;
1016:Src/main.c    ****         current_block += blocks_in_batch;
1017:Src/main.c    ****     }
1018:Src/main.c    **** 
1019:Src/main.c    ****     printf("[SD Store] OK (blocks %lu..%lu, %lu HAL calls vs %lu original)\n",
1020:Src/main.c    ****            (unsigned long)base, (unsigned long)(current_block - 1),
1021:Src/main.c    ****            (unsigned long)((total_blocks + SD_BATCH_WRITE_BLOCKS - 1) / SD_BATCH_WRITE_BLOCKS),
1022:Src/main.c    ****            (unsigned long)total_blocks);
1023:Src/main.c    ****     return 0;
1024:Src/main.c    **** }
