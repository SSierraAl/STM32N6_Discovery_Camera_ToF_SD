  86:Src/main.c    **** /* ================================================================
  87:Src/main.c    ****    SECTION 2.5: LOW-POWER TRACE PRINT MACROS
  88:Src/main.c    ****    ================================================================
  89:Src/main.c    ****    Conditional printf wrappers controlled by app_config.h flags.
  90:Src/main.c    ****    All compile to nothing when LP_TRACE_ALL = 0.
  91:Src/main.c    ****    ================================================================ */
  92:Src/main.c    **** 
  93:Src/main.c    **** #if LP_TRACE_ALL
  94:Src/main.c    **** /** Helper: print only if the given sub-flag is nonzero (runtime check). */
  95:Src/main.c    **** #define LP_PRINT(flag, ...)  do { if ((flag)) printf(__VA_ARGS__); } while(0)
  96:Src/main.c    **** /** Register modification trace: prints name @addr, before value -> after value. */
  97:Src/main.c    **** #define LP_TRACE_REG(mod_name, addr, before, after)                    \
  98:Src/main.c    ****     do {                                                                \
  99:Src/main.c    ****         if (LP_TRACE_REGISTER_MODS)                                     \
 100:Src/main.c    ****             printf("[REG] %-20s @0x%08lX  0x%08lX -> 0x%08lX\n",       \
 101:Src/main.c    ****                    (mod_name), (unsigned long)(addr),                    \
 102:Src/main.c    ****                    (unsigned long)(before), (unsigned long)(after));     \
 103:Src/main.c    ****     } while(0)
 104:Src/main.c    **** #else
 105:Src/main.c    **** #define LP_PRINT(flag, ...)           ((void)0)
 106:Src/main.c    **** #define LP_TRACE_REG(mod_name, addr, before, after)  ((void)0)
 107:Src/main.c    **** #endif
