 636:Src/main.c    ****     int found = 0;
 637:Src/main.c    ****     for (int i = 0; i < (int)(sizeof(phy_tbl)/sizeof(phy_tbl[0])); i++)
 638:Src/main.c    ****     {
 639:Src/main.c    ****         uint32_t reg = ETH_PD_ReadPHYReg(eth, phy_tbl[i], ETH_PD_BMCR_REG);
 640:Src/main.c    ****         if (reg != 0xFFFFFFFFU && reg != 0x0000U)
