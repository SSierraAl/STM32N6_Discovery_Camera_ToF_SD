 214:Src/main.c    **** /** Camera frame buffer — allocated in PSRAM for DMA access.
 215:Src/main.c    ****     NOTE: Not static — referenced via extern by app_cam.c (CAM_ContinuousSnap). */
 216:Src/main.c    **** uint8_t capture_buf[MAX_SNAP_FRAME_SIZE] ALIGN_32 IN_PSRAM;
 217:Src/main.c    **** 
 218:Src/main.c    **** /** SD batch-write buffer — allocated in PSRAM for multi-block writes.
 219:Src/main.c    ****     Size = SD_BATCH_WRITE_BLOCKS * SD_BLOCK_SIZE = 64 * 512 = 32 KB.
 220:Src/main.c    ****     This buffer holds multiple 512-byte SD blocks so we can write them
 221:Src/main.c    ****     in a single HAL_SD_WriteBlocks() call, drastically reducing the
 222:Src/main.c    ****     number of HAL API calls per snapshot (~307 instead of ~19,643).
 223:Src/main.c    ****     NOTE: Not static — referenced by app_thread.c (storage_task). */
 224:Src/main.c    **** uint8_t sd_batch_buf[SD_BATCH_WRITE_BLOCKS * SD_BLOCK_SIZE] ALIGN_32 IN_PSRAM;
 225:Src/main.c    **** 
 226:Src/main.c    **** /** Save buffer — allocated in PSRAM.
 227:Src/main.c    ****     In CONTINUOUS mode (CAPTURE_MODE=1), the camera double-buffers between
 228:Src/main.c    ****     capture_buf/capture_buf2 continuously (no stop/restart). On ToF trigger,
 229:Src/main.c    ****     CAM_ContinuousSnap() waits for the next completed frame and copies it
 230:Src/main.c    ****     (once) into save_buf, which is what gets written to SD.
 231:Src/main.c    ****     In CALLBACK-BATCH mode (CAPTURE_MODE=4), save_buf is used as the
 232:Src/main.c    ****     second ping-pong buffer for hardware double-buffering (DCMIPP
 233:Src/main.c    ****     alternates DMA between capture_buf and save_buf automatically).
 234:Src/main.c    ****     NOTE: Not static — referenced via extern by app_thread.c (mode 1)
 235:Src/main.c    ****     and app_cam.c (mode 4). */
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccXjqF6n.s 			page 38


 236:Src/main.c    **** #if CAPTURE_MODE == 1 || CAPTURE_MODE == 4
 237:Src/main.c    **** uint8_t save_buf[MAX_SNAP_FRAME_SIZE] ALIGN_32 IN_PSRAM;
 238:Src/main.c    **** #endif
 239:Src/main.c    **** 
 240:Src/main.c    **** /** Second raw ping-pong buffer for CONTINUOUS mode's hardware double
 241:Src/main.c    ****     buffering (CAPTURE_MODE=1 only). DCMIPP alternates DMA between
 242:Src/main.c    ****     capture_buf and capture_buf2 forever while the pipe is running; on
 243:Src/main.c    ****     trigger, CAM_ContinuousSnap() figures out which one just completed and
 244:Src/main.c    ****     copies ONLY that one frame into save_buf.
 245:Src/main.c    ****     NOTE: Not static — referenced via extern by app_cam.c. */
 246:Src/main.c    **** #if CAPTURE_MODE == 1
 247:Src/main.c    **** uint8_t capture_buf2[MAX_SNAP_FRAME_SIZE] ALIGN_32 IN_PSRAM;
 248:Src/main.c    **** #endif
 249:Src/main.c    **** 
 250:Src/main.c    **** /** Batch buffer for batch capture mode — allocated in PSRAM.
 251:Src/main.c    ****     Used in BATCH mode (CAPTURE_MODE=2) and CALLBACK-BATCH mode (CAPTURE_MODE=4).
 252:Src/main.c    ****      On ToF trigger, we grab BATCH_FRAMES into batch_buf
 253:Src/main.c    ****      (each slot = SNAP_FRAME_SIZE), then send them to storage_task
 254:Src/main.c    ****      sequentially for SD writing.
 255:Src/main.c    **** 
 256:Src/main.c    ****      Size = BATCH_FRAMES × SNAP_FRAME_SIZE
 257:Src/main.c    ****      For 1296x972@YUV422 (2.5MB/frame), BATCH_FRAMES=3 → 7.5MB total.
 258:Src/main.c    ****      NOTE: Not static — referenced via extern by app_thread.c (camera_task). */
 259:Src/main.c    **** #if CAPTURE_MODE == 4
 260:Src/main.c    **** uint8_t batch_buf[BATCH_BUF_SIZE] ALIGN_32 IN_PSRAM;
 261:Src/main.c    **** #endif
 262:Src/main.c    **** 
 263:Src/main.c    **** /** Capture-in-progress guard — prevents simultaneous captures.
 264:Src/main.c    ****     When set to 1, new detection events are ignored until the current
 265:Src/main.c    ****     capture + SD write is complete. */
 266:Src/main.c    **** static volatile int capture_in_progress = 0;
