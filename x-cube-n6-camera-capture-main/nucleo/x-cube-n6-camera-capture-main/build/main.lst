   1:Src/main.c    **** #include "raw_image.h"
   2:Src/main.c    **** /**
   3:Src/main.c    ****  * *****************************************************************************
   4:Src/main.c    ****  * @file    main.c
   5:Src/main.c    ****  * @brief   Standalone Camera + ToF Snapshot Capture — NUCLEO-N657X0-Q
   6:Src/main.c    ****  *
   7:Src/main.c    ****  *   Captures images from the CMW-IMX335 camera module and stores them as
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccXjqF6n.s 			page 34


   8:Src/main.c    ****  *   raw YUV422 frames on a microSD card.  Includes VL53L5CX Time-of-Flight
   9:Src/main.c    ****  *   sensor integration for distance measurements.
  10:Src/main.c    ****  *
  11:Src/main.c    ****  *   No USB/UVC, no FileX/fatfs, no PC connection required after flashing.
  12:Src/main.c    ****  *
  13:Src/main.c    ****  *   Hardware:
  14:Src/main.c    ****  *     - MCU:      STM32N657 (NUCLEO-N657X0-Q / MB1940)
  15:Src/main.c    ****  *     - Camera:   CMW-IMX335 (5 MP, YUV422 output via CSI-2)
  16:Src/main.c    ****  *     - ToF:      VL53L5CX (8x8 resolution, continuous mode)
  17:Src/main.c    ****  *     - Storage:  microSD card (SDMMC2, 4-bit bus)
  18:Src/main.c    ****  *     - Button:   USER B1 = PC13 (active HIGH, external pull-down)
  19:Src/main.c    ****  *     - LEDs:     RED = PG10, GREEN = PG0
  20:Src/main.c    ****  *     - Illumination: WS2812 (GPDMA1 + TIM1 PWM)
  21:Src/main.c    ****  *
  22:Src/main.c    ****  *   Flow (OPTIMIZED - Sleep Mode):
  23:Src/main.c    ****  *     1. Boot → init clocks, MPU, PSRAM, SD card
  24:Src/main.c    ****  *     2. Init camera + warmup frames (one-time cost at boot)
  25:Src/main.c    ****  *     3. STOP camera pipe (sleep = low power, fast wakeup)
  26:Src/main.c    ****  *     4. GREEN LED on (system ready)
  27:Src/main.c    ****  *     5. User presses USER button (PC13)
  28:Src/main.c    ****  *     6. START pipe → 3 frames → capture → STOP pipe (~100ms total)
  29:Src/main.c    ****  *     7. Frame saved to SD card
  30:Src/main.c    ****  *     8. Back to sleep → wait for next press
  31:Src/main.c    ****  *
  32:Src/main.c    ****  *   Two FreeRTOS tasks:
  33:Src/main.c    ****  *     - main_thread: board init, SD card init, camera sleep mode init,
  34:Src/main.c    ****  *                    then deletes itself
  35:Src/main.c    ****  *     - btn_thread:  polls USER button, triggers fast capture + SD write
  36:Src/main.c    ****  *
  37:Src/main.c    ****  *   All configurable parameters are in Inc/app_config.h.
  38:Src/main.c    ****  * *****************************************************************************
  39:Src/main.c    ****  */
  40:Src/main.c    **** 
  41:Src/main.c    **** /* ================================================================
  42:Src/main.c    ****    SECTION 1: INCLUDES
  43:Src/main.c    ****    ================================================================ */
