 713:Src/main.c    ****     CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
 714:Src/main.c    **** 
 715:Src/main.c    ****     /* Disable DWT cycle counter before programming */
 716:Src/main.c    ****     DWT->CTRL &= ~DWT_CTRL_CYCCNTENA_Msk;
 717:Src/main.c    **** 
