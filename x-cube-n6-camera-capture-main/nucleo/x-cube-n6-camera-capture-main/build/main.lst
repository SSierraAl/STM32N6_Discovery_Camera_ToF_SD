1230:Src/main.c    ****                             tskIDLE_PRIORITY + 4,
1231:Src/main.c    ****                             sensor_thread_stack, &sensor_thread_cb);
1232:Src/main.c    ****     assert(hdl != NULL);
1233:Src/main.c    **** #else
1234:Src/main.c    ****     (void)sensor_thread_stack;
1235:Src/main.c    ****     (void)sensor_thread_cb;
1236:Src/main.c    **** #endif
1237:Src/main.c    **** 
1238:Src/main.c    ****     /* ---- Button task (manual capture, ON-DEMAND mode only) ---- */
1239:Src/main.c    **** #if CAPTURE_MODE == 0
1240:Src/main.c    ****     hdl = xTaskCreateStatic(btn_thread_fct, "btn",
1241:Src/main.c    ****                             4 * configMINIMAL_STACK_SIZE, NULL,
1242:Src/main.c    ****                             tskIDLE_PRIORITY + 3,
1243:Src/main.c    ****                             btn_thread_stack, &btn_thread_cb);
1244:Src/main.c    ****     assert(hdl != NULL);
1245:Src/main.c    **** #else
