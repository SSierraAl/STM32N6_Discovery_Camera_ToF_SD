 589:Src/main.c    ****     /* ---- 1. Release ETH1 from reset (in case boot ROM left it asserted) ---- */
 590:Src/main.c    ****     __HAL_RCC_ETH1_FORCE_RESET();
 591:Src/main.c    ****     __HAL_RCC_ETH1_RELEASE_RESET();
 592:Src/main.c    **** 
 593:Src/main.c    ****     /* ---- 2. Configure ETH1 clock tree for MDIO operation ----
 594:Src/main.c    ****        ETH1CLKSEL  (bits 12-13) = 0 = HCLK (400 MHz, always running)
 595:Src/main.c    ****        ETH1SEL     (bits 16-18) = 1 = RGMII (board uses RTL8211F with RGMII)
 596:Src/main.c    ****        ETH1PTPSEL  (bits 0-1)   = 0 = HCLK
 597:Src/main.c    ****        ETH1PTPDIV  (bits 4-7)   = 0 = divide by 1 */
 598:Src/main.c    ****     {
 599:Src/main.c    ****         uint32_t ccipr2_before = RCC->CCIPR2;
 600:Src/main.c    ****         MODIFY_REG(RCC->CCIPR2, RCC_CCIPR2_ETH1CLKSEL, LL_RCC_ETH1_CLKSOURCE_HCLK);
 601:Src/main.c    ****         MODIFY_REG(RCC->CCIPR2, RCC_CCIPR2_ETH1SEL,    LL_RCC_ETH1PHY_IF_RGMII);
 602:Src/main.c    ****         MODIFY_REG(RCC->CCIPR2, RCC_CCIPR2_ETH1PTPDIV, 0U);
 603:Src/main.c    ****         LP_TRACE_REG("RCC->CCIPR2", &RCC->CCIPR2, ccipr2_before, RCC->CCIPR2);
 604:Src/main.c    ****     }
 605:Src/main.c    **** 
 606:Src/main.c    ****     /* ---- 3. Enable ETH1 peripheral clocks ---- */
 607:Src/main.c    ****     __HAL_RCC_ETH1_CLK_ENABLE();
 608:Src/main.c    ****     __HAL_RCC_ETH1MAC_CLK_ENABLE();
 609:Src/main.c    ****     __HAL_RCC_ETH1TX_CLK_ENABLE();
 610:Src/main.c    ****     __HAL_RCC_ETH1RX_CLK_ENABLE();
 611:Src/main.c    **** 
 612:Src/main.c    ****     __HAL_RCC_GPIOA_CLK_ENABLE();
 613:Src/main.c    ****     __HAL_RCC_GPIOB_CLK_ENABLE();
 614:Src/main.c    ****     __HAL_RCC_GPIOC_CLK_ENABLE();
 615:Src/main.c    ****     __HAL_RCC_GPIOG_CLK_ENABLE();
 616:Src/main.c    **** 
 617:Src/main.c    ****     /* ---- 4. Configure MDIO (PA4) + MDC (PC1) as AF11 (ETH1) ---- */
 618:Src/main.c    ****     GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
 619:Src/main.c    ****     GPIO_InitStruct.Pull = GPIO_PULLUP;
 620:Src/main.c    ****     GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_MEDIUM;
 621:Src/main.c    ****     GPIO_InitStruct.Alternate = GPIO_AF11_ETH1;
 622:Src/main.c    ****     GPIO_InitStruct.Pin = GPIO_PIN_4;
 623:Src/main.c    ****     HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);
 624:Src/main.c    ****     GPIO_InitStruct.Pin = GPIO_PIN_1;
 625:Src/main.c    ****     HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);
 626:Src/main.c    **** 
 627:Src/main.c    ****     /* ---- 5. Set MDIO clock range (HCLK ~400MHz -> DIV124 -> ~3.2 MHz) ---- */
 628:Src/main.c    ****     ETH_PD_SetMDIOClockRange(eth);
 629:Src/main.c    **** 
 630:Src/main.c    ****     /* ---- 6. Power-down the RTL8211F PHY via MDIO ----
 631:Src/main.c    ****        RTL8211F on STM32N6570-DK typically at PHY address 0x00.
 632:Src/main.c    ****        Try common addresses. A valid BMCR is non-zero (default 0x1000).
 633:Src/main.c    ****        If BMCR reads 0x0000, the PHY didn't respond — also try reading
 634:Src/main.c    ****        PHY ID registers (reg 2 = PHY ID1) for better detection. */
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccXjqF6n.s 			page 45


