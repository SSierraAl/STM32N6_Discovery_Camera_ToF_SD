 722:Src/main.c    ****     DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
 723:Src/main.c    **** 
 724:Src/main.c    ****     LP_PRINT(LP_TRACE_WAKEUP_LATENCY_US, "[LP] DWT cycle counter enabled (CPU freq = %lu Hz)\n",
 725:Src/main.c    ****              (unsigned long)HAL_RCC_GetHCLKFreq());
 726:Src/main.c    **** }
