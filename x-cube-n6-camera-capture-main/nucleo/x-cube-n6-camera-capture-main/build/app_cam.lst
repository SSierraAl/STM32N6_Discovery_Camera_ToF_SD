   1:Inc/perf_debug.h **** /**
   2:Inc/perf_debug.h ****  * ******************************************************************************
   3:Inc/perf_debug.h ****  * @file    perf_debug.h
   4:Inc/perf_debug.h ****  * @brief   Performance Debug Framework — Granular Timing + Bottleneck Analysis
   5:Inc/perf_debug.h ****  *
   6:Inc/perf_debug.h ****  *   PURPOSE:
   7:Inc/perf_debug.h ****  *     Replace scattered printf() timing with a structured, configurable
   8:Inc/perf_debug.h ****  *     debug system that identifies where time is spent during capture:
   9:Inc/perf_debug.h ****  *       - Camera init (sensor detect, I2C config, DCMIPP setup)
  10:Inc/perf_debug.h ****  *       - Camera capture (exposure/gain, warmup frames, frame acquisition)
  11:Inc/perf_debug.h ****  *       - Camera deinit (pipe stop, deinit)
  12:Inc/perf_debug.h ****  *       - SD storage (card ready wait, batch writes, inter-batch gaps)
  13:Inc/perf_debug.h ****  *     Then print a clear summary with bottleneck identification.
  14:Inc/perf_debug.h ****  *
  15:Inc/perf_debug.h ****  *   Timer ownership: Capture_RequestSnapshot starts/stops the cycle timer.
  16:Inc/perf_debug.h ****  *   Camera and storage tasks add markers/counters before giving completion
  17:Inc/perf_debug.h ****  *   semaphores. Markers retain their FIRST occurrence; phase_count records
  18:Inc/perf_debug.h ****  *   repeated hits. SD wall time is accumulated separately for every command.
  19:Inc/perf_debug.h ****  *
  20:Inc/perf_debug.h ****  *   DEBUG LEVELS (controlled by PERF_DEBUG_LEVEL in app_config.h):
  21:Inc/perf_debug.h ****  *     0 = Production: only final total time
  22:Inc/perf_debug.h ****  *     1 = Standard: phase breakdown percentages
  23:Inc/perf_debug.h ****  *     2 = Verbose: sub-phase timing + per-batch SD info (throttled)
  24:Inc/perf_debug.h ****  *     3 = Debug: everything + raw counters + wait-state details
  25:Inc/perf_debug.h ****  *
  26:Inc/perf_debug.h ****  * ******************************************************************************
  27:Inc/perf_debug.h ****  */
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccnpdmuN.s 			page 12


