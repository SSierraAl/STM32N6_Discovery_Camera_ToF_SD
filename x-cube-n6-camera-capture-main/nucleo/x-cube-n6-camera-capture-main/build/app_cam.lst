  48:Src/app_cam.c **** /* Multi-byte register write helper */
  49:Src/app_cam.c **** int CAM_WriteSensorRegMulti(uint16_t reg, const uint8_t *data, uint16_t len)
  50:Src/app_cam.c **** {
  51:Src/app_cam.c ****   return CMW_I2C_WRITEREG16(CAMERA_IMX335_ADDRESS, reg, (uint8_t *)data, len);
  52:Src/app_cam.c **** }
  53:Src/app_cam.c **** 
  54:Src/app_cam.c **** /* ================================================================
  55:Src/app_cam.c ****    IMX335 AREA3 / ROI register sequence
  56:Src/app_cam.c ****    ================================================================
  57:Src/app_cam.c ****    Full standby→hold→write→stream sequence with retry logic.
  58:Src/app_cam.c ****    Reference: MASSIF-ROI-Windowing project, App_ChangeROI().
  59:Src/app_cam.c ****    ================================================================ */
  60:Src/app_cam.c **** 
  61:Src/app_cam.c **** #define IMX335_REG_HOLD       0x3001U
  62:Src/app_cam.c **** #define IMX335_REG_VMAX       0x3030U
  63:Src/app_cam.c **** #define IMX335_REG_SHUTTER    0x3058U
  64:Src/app_cam.c **** #define AREA3_ST_ADR_X        0x3074U
  65:Src/app_cam.c **** #define AREA3_ST_ADR_Y        0x3076U
  66:Src/app_cam.c **** #define AREA3_END_ADR_X       0x3078U
  67:Src/app_cam.c **** #define AREA3_END_ADR_Y       0x307AU
  68:Src/app_cam.c **** #define IMX335_SENSOR_W       2592
  69:Src/app_cam.c **** #define IMX335_SENSOR_H       1944
  70:Src/app_cam.c **** 
  71:Src/app_cam.c **** /** Helper: write 3-byte (24-bit) value to sensor, little-endian. */
  72:Src/app_cam.c **** static int CAM_WriteSensorReg24(uint16_t reg, uint32_t value)
  73:Src/app_cam.c **** {
  74:Src/app_cam.c ****   uint8_t d[3];
  75:Src/app_cam.c ****   d[0] = (uint8_t)(value & 0xFFU);
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccnpdmuN.s 			page 4


  76:Src/app_cam.c ****   d[1] = (uint8_t)((value >> 8) & 0xFFU);
  77:Src/app_cam.c ****   d[2] = (uint8_t)((value >> 16) & 0xFFU);
  78:Src/app_cam.c ****   return CMW_I2C_WRITEREG16(CAMERA_IMX335_ADDRESS, reg, d, 3);
  79:Src/app_cam.c **** }
  80:Src/app_cam.c **** 
  81:Src/app_cam.c **** /** Helper: write 4-byte (32-bit) value to sensor, little-endian. */
  82:Src/app_cam.c **** static int CAM_WriteSensorReg32(uint16_t reg, uint32_t value)
  83:Src/app_cam.c **** {
  84:Src/app_cam.c ****   uint8_t d[4];
  85:Src/app_cam.c ****   d[0] = (uint8_t)(value & 0xFFU);
  86:Src/app_cam.c ****   d[1] = (uint8_t)((value >> 8) & 0xFFU);
  87:Src/app_cam.c ****   d[2] = (uint8_t)((value >> 16) & 0xFFU);
  88:Src/app_cam.c ****   d[3] = (uint8_t)((value >> 24) & 0xFFU);
  89:Src/app_cam.c ****   return CMW_I2C_WRITEREG16(CAMERA_IMX335_ADDRESS, reg, d, 4);
  90:Src/app_cam.c **** }
  91:Src/app_cam.c **** 
  92:Src/app_cam.c **** int CAM_SetSensorROI(uint16_t x_start, uint16_t y_start,
  93:Src/app_cam.c ****                      uint16_t width, uint16_t height)
  94:Src/app_cam.c **** {
  95:Src/app_cam.c ****   uint16_t x_end, y_end;
  96:Src/app_cam.c ****   uint32_t vmax, shutter;
  97:Src/app_cam.c ****   int      retry, ret;
  98:Src/app_cam.c ****   uint8_t  data[4];
  99:Src/app_cam.c **** 
 100:Src/app_cam.c ****   /* Validate */
 101:Src/app_cam.c ****   if (width < 16 || height < 4) return -1;
 102:Src/app_cam.c ****   if ((uint32_t)x_start + width > IMX335_SENSOR_W) return -1;
 103:Src/app_cam.c ****   if ((uint32_t)y_start + height > IMX335_SENSOR_H) return -1;
 104:Src/app_cam.c **** 
 105:Src/app_cam.c ****   x_end = x_start + width - 1;
 106:Src/app_cam.c ****   y_end = y_start + height - 1;
 107:Src/app_cam.c **** 
 108:Src/app_cam.c ****   /* VMAX = output height + blanking (100 lines for stability, per ref project) */
 109:Src/app_cam.c ****   vmax   = height + 100;
 110:Src/app_cam.c ****   shutter = vmax - 100;
 111:Src/app_cam.c ****   if (shutter < 9) shutter = 9;
 112:Src/app_cam.c **** 
 113:Src/app_cam.c ****   printf("[CAM] SetSensorROI: (%u,%u) %ux%u → VMAX=%lu SHUTTER=%lu\n",
 114:Src/app_cam.c ****          x_start, y_start, width, height, (unsigned long)vmax, (unsigned long)shutter);
 115:Src/app_cam.c **** 
 116:Src/app_cam.c ****   /* Step 1: STANDBY (0x3000 = 0x01) with retry */
 117:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 118:Src/app_cam.c ****     ret = CAM_WriteSensorReg(IMX335_REG_MODE_SELECT, IMX335_MODE_STANDBY);
 119:Src/app_cam.c ****     if (ret == 0) break;
 120:Src/app_cam.c ****     HAL_Delay(5);
 121:Src/app_cam.c ****   }
 122:Src/app_cam.c ****   if (ret) return -1;
 123:Src/app_cam.c ****   HAL_Delay(20);
 124:Src/app_cam.c **** 
 125:Src/app_cam.c ****   /* Step 2: Set HOLD (0x3001 = 0x01) with retry */
 126:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 127:Src/app_cam.c ****     ret = CAM_WriteSensorReg(IMX335_REG_HOLD, 0x01);
 128:Src/app_cam.c ****     if (ret == 0) break;
 129:Src/app_cam.c ****     HAL_Delay(5);
 130:Src/app_cam.c ****   }
 131:Src/app_cam.c ****   if (ret) return -1;
 132:Src/app_cam.c **** 
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccnpdmuN.s 			page 5


 133:Src/app_cam.c ****   /* Step 3: Write AREA3 registers (little-endian 16-bit) with retry */
 134:Src/app_cam.c ****   data[0] = (uint8_t)(x_start & 0xFFU);
 135:Src/app_cam.c ****   data[1] = (uint8_t)((x_start >> 8) & 0xFFU);
 136:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 137:Src/app_cam.c ****     ret = CAM_WriteSensorRegMulti(AREA3_ST_ADR_X, data, 2);
 138:Src/app_cam.c ****     if (ret == 0) break;
 139:Src/app_cam.c ****     HAL_Delay(5);
 140:Src/app_cam.c ****   }
 141:Src/app_cam.c ****   if (ret) return -1;
 142:Src/app_cam.c **** 
 143:Src/app_cam.c ****   data[0] = (uint8_t)(y_start & 0xFFU);
 144:Src/app_cam.c ****   data[1] = (uint8_t)((y_start >> 8) & 0xFFU);
 145:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 146:Src/app_cam.c ****     ret = CAM_WriteSensorRegMulti(AREA3_ST_ADR_Y, data, 2);
 147:Src/app_cam.c ****     if (ret == 0) break;
 148:Src/app_cam.c ****     HAL_Delay(5);
 149:Src/app_cam.c ****   }
 150:Src/app_cam.c ****   if (ret) return -1;
 151:Src/app_cam.c **** 
 152:Src/app_cam.c ****   data[0] = (uint8_t)(x_end & 0xFFU);
 153:Src/app_cam.c ****   data[1] = (uint8_t)((x_end >> 8) & 0xFFU);
 154:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 155:Src/app_cam.c ****     ret = CAM_WriteSensorRegMulti(AREA3_END_ADR_X, data, 2);
 156:Src/app_cam.c ****     if (ret == 0) break;
 157:Src/app_cam.c ****     HAL_Delay(5);
 158:Src/app_cam.c ****   }
 159:Src/app_cam.c ****   if (ret) return -1;
 160:Src/app_cam.c **** 
 161:Src/app_cam.c ****   data[0] = (uint8_t)(y_end & 0xFFU);
 162:Src/app_cam.c ****   data[1] = (uint8_t)((y_end >> 8) & 0xFFU);
 163:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 164:Src/app_cam.c ****     ret = CAM_WriteSensorRegMulti(AREA3_END_ADR_Y, data, 2);
 165:Src/app_cam.c ****     if (ret == 0) break;
 166:Src/app_cam.c ****     HAL_Delay(5);
 167:Src/app_cam.c ****   }
 168:Src/app_cam.c ****   if (ret) return -1;
 169:Src/app_cam.c **** 
 170:Src/app_cam.c ****   /* Step 4: Write VMAX (32-bit) with retry */
 171:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 172:Src/app_cam.c ****     ret = CAM_WriteSensorReg32(IMX335_REG_VMAX, vmax);
 173:Src/app_cam.c ****     if (ret == 0) break;
 174:Src/app_cam.c ****     HAL_Delay(5);
 175:Src/app_cam.c ****   }
 176:Src/app_cam.c ****   if (ret) return -1;
 177:Src/app_cam.c **** 
 178:Src/app_cam.c ****   /* Step 5: Write SHUTTER (24-bit) with retry */
 179:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 180:Src/app_cam.c ****     ret = CAM_WriteSensorReg24(IMX335_REG_SHUTTER, shutter);
 181:Src/app_cam.c ****     if (ret == 0) break;
 182:Src/app_cam.c ****     HAL_Delay(5);
 183:Src/app_cam.c ****   }
 184:Src/app_cam.c ****   if (ret) return -1;
 185:Src/app_cam.c **** 
 186:Src/app_cam.c ****   /* Step 6: Clear HOLD to apply (0x3001 = 0x00) */
 187:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 188:Src/app_cam.c ****     ret = CAM_WriteSensorReg(IMX335_REG_HOLD, 0x00);
 189:Src/app_cam.c ****     if (ret == 0) break;
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccnpdmuN.s 			page 6


 190:Src/app_cam.c ****     HAL_Delay(5);
 191:Src/app_cam.c ****   }
 192:Src/app_cam.c ****   if (ret) return -1;
 193:Src/app_cam.c ****   HAL_Delay(30);
 194:Src/app_cam.c **** 
 195:Src/app_cam.c ****   /* Step 7: STREAMING (0x3000 = 0x00) */
 196:Src/app_cam.c ****   for (retry = 0; retry < 3; retry++) {
 197:Src/app_cam.c ****     ret = CAM_WriteSensorReg(IMX335_REG_MODE_SELECT, IMX335_MODE_STREAMING);
 198:Src/app_cam.c ****     if (ret == 0) break;
 199:Src/app_cam.c ****     HAL_Delay(5);
 200:Src/app_cam.c ****   }
 201:Src/app_cam.c ****   if (ret) return -1;
 202:Src/app_cam.c ****   HAL_Delay(50);
 203:Src/app_cam.c **** 
 204:Src/app_cam.c ****   printf("[CAM] Sensor ROI configured: %dx%d from (%u,%u)\n",
 205:Src/app_cam.c ****          width, height, x_start, y_start);
 206:Src/app_cam.c ****   return 0;
 207:Src/app_cam.c **** }
