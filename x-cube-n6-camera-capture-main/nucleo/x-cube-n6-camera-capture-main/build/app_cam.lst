 109:Src/app_cam.c **** static int CAM_getFlipMode(CMW_Sensor_Name_t s)
 110:Src/app_cam.c **** {
 111:Src/app_cam.c ****   int mode = CMW_MIRRORFLIP_NONE;
 112:Src/app_cam.c ****   int idx = 0;
 113:Src/app_cam.c ****   switch (s) {
 114:Src/app_cam.c ****     case CMW_VD66GY_Sensor:    mode = SENSOR_VD66GY_FLIP; idx = 1; break;
 115:Src/app_cam.c ****     case CMW_IMX335_Sensor:    mode = SENSOR_IMX335_FLIP; idx = 2; break;
 116:Src/app_cam.c ****     case CMW_VD55G1_Sensor:    mode = SENSOR_VD55G1_FLIP; idx = 3; break;
 117:Src/app_cam.c ****     case CMW_VD1943_Sensor:    mode = SENSOR_VD1943_FLIP; idx = 4; break;
 118:Src/app_cam.c ****     default: assert(0);
 119:Src/app_cam.c ****   }
 120:Src/app_cam.c ****   printf("Detected %s\n", sensor_names[idx]);
 121:Src/app_cam.c ****   return mode;
 122:Src/app_cam.c **** }
 123:Src/app_cam.c **** 
 124:Src/app_cam.c **** static int CAM_FormatToBpp(int fmt)
 125:Src/app_cam.c **** {
 126:Src/app_cam.c ****   switch (fmt) {
 127:Src/app_cam.c ****     case DCMIPP_PIXEL_PACKER_FORMAT_MONO_Y8_G8_1: return 1;
 128:Src/app_cam.c ****     case DCMIPP_PIXEL_PACKER_FORMAT_RGB565_1:
 129:Src/app_cam.c ****     case DCMIPP_PIXEL_PACKER_FORMAT_YUV422_1: return 2;
 130:Src/app_cam.c ****     case DCMIPP_PIXEL_PACKER_FORMAT_RGB888_YUV444_1: return 3;
 131:Src/app_cam.c ****     default: assert(0); return 0;
 132:Src/app_cam.c ****   }
 133:Src/app_cam.c **** }
 134:Src/app_cam.c **** 
 135:Src/app_cam.c **** static void CAM_InitCropConfig(CMW_Manual_roi_area_t *roi, int sw, int sh, CAM_conf_t *conf)
 136:Src/app_cam.c **** {
 137:Src/app_cam.c ****   float rx = (float)sw / conf->capture_width;
 138:Src/app_cam.c ****   float ry = (float)sh / conf->capture_height;
 139:Src/app_cam.c ****   float r = MIN(rx, ry);
 140:Src/app_cam.c ****   assert(r >= 1 && r < 64);
 141:Src/app_cam.c ****   roi->width  = (uint32_t)MIN(conf->capture_width * r, sw);
 142:Src/app_cam.c ****   roi->height = (uint32_t)MIN(conf->capture_height * r, sh);
 143:Src/app_cam.c ****   roi->offset_x = (sw - roi->width + 1) / 2;
 144:Src/app_cam.c ****   roi->offset_y = (sh - roi->height + 1) / 2;
 145:Src/app_cam.c **** }
