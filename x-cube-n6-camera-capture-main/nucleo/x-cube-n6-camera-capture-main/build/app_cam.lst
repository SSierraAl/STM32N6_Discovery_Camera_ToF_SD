 940:Src/app_cam.c **** #endif
 941:Src/app_cam.c ****   {
 942:Src/app_cam.c ****     const uint32_t total = (uint32_t)CALLBACK_WARMUP_FRAMES + (uint32_t)CALLBACK_FRAMES;
 943:Src/app_cam.c ****     uint32_t frame_seq = 0;
 944:Src/app_cam.c **** 
 945:Src/app_cam.c ****     for (uint32_t k = 0; k < total; k++) {
 946:Src/app_cam.c ****       uint32_t frame_ms = 0;
 947:Src/app_cam.c **** 
 948:Src/app_cam.c ****       if (k == CALLBACK_WARMUP_FRAMES) {
 949:Src/app_cam.c ****         PERF_MARK(g_perf_timer, CAM_SNAP);
 950:Src/app_cam.c ****       }
