 302:Src/app_cam.c **** {
 303:Src/app_cam.c ****   float rx = (float)sw / conf->capture_width;
 304:Src/app_cam.c ****   float ry = (float)sh / conf->capture_height;
 305:Src/app_cam.c ****   float r = MIN(rx, ry);
 306:Src/app_cam.c ****   assert(r >= 1 && r < 64);
 307:Src/app_cam.c ****   roi->width  = (uint32_t)MIN(conf->capture_width * r, sw);
 308:Src/app_cam.c ****   roi->height = (uint32_t)MIN(conf->capture_height * r, sh);
 309:Src/app_cam.c ****   roi->offset_x = (sw - roi->width + 1) / 2;
 310:Src/app_cam.c ****   roi->offset_y = (sh - roi->height + 1) / 2;
 311:Src/app_cam.c **** }
