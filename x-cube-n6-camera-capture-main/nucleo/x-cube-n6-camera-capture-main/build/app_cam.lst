 970:Src/app_cam.c ****         captured++;
 971:Src/app_cam.c ****       }
 972:Src/app_cam.c **** 
 973:Src/app_cam.c ****       /* Arm the address that JUST freed (used by the frame that just
 974:Src/app_cam.c ****          completed) for reuse 2 frames from now, if that future frame is
 975:Src/app_cam.c ****          one we want to keep. */
 976:Src/app_cam.c ****       int32_t arm_idx = out_idx + 2;
 977:Src/app_cam.c ****       if (arm_idx >= 0 && arm_idx < CALLBACK_FRAMES) {
