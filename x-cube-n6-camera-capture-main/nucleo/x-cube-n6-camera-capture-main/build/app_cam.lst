 637:Src/app_cam.c **** /* ================================================================
 638:Src/app_cam.c ****    CALLBACK-BATCH MODE (CAPTURE_MODE = 4)
 639:Src/app_cam.c ****    Callback-driven continuous batch capture — NO Stop/Restart between frames.
 640:Src/app_cam.c **** 
 641:Src/app_cam.c ****    Uses g_frame_event_count (incremented by DCMIPP frame event ISR callback)
 642:Src/app_cam.c ****    to know EXACTLY when each frame DMA is complete. The pipe runs continuously
 643:Src/app_cam.c ****    through the entire batch, eliminating Stop/Restart tearing.
 644:Src/app_cam.c ****    ================================================================ */
 645:Src/app_cam.c **** 
 646:Src/app_cam.c **** int CAM_CallbackInit(uint8_t *buf, int buf_size, int width, int height, int fps)
 647:Src/app_cam.c **** {
