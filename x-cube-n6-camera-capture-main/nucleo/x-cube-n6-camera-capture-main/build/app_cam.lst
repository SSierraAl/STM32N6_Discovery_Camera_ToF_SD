 460:Src/app_cam.c **** /**
 461:Src/app_cam.c ****  * @brief  Block until DCMIPP confirms a full frame has been DMA'd into
 462:Src/app_cam.c ****  *         capture_buf (CMW_CAMERA_PIPE_FrameEventCallback -> CAM_NotifyFrameEvent).
 463:Src/app_cam.c ****  *
 464:Src/app_cam.c ****  *   IMPORTANT: This must gate ONLY on the frame-complete event, not VSYNC.
 465:Src/app_cam.c ****  *   VSYNC marks the START of the next frame (sensor row-sync) and can fire
 466:Src/app_cam.c ****  *   slightly before DCMIPP finishes writing the previous frame to PSRAM.
 467:Src/app_cam.c ****  *   Gating on "vsync OR frame_event" (as before) could let the caller stop
 468:Src/app_cam.c ****  *   the pipe and memcpy a frame that is still being written -> partial/black
 469:Src/app_cam.c ****  *   or torn images, worse for a moving subject.
 470:Src/app_cam.c ****  * @return 0 on success, -1 on timeout (elapsed_ms optionally reports actual wait)
 471:Src/app_cam.c ****  */
 472:Src/app_cam.c **** static int CAM_WaitNextFrameReady(uint32_t timeout_ms, uint32_t *elapsed_ms)
 473:Src/app_cam.c **** {
 474:Src/app_cam.c ****   uint32_t start_evt = g_frame_event_count;
 475:Src/app_cam.c ****   uint32_t t0 = HAL_GetTick();
 476:Src/app_cam.c **** 
 477:Src/app_cam.c ****   while (g_frame_event_count == start_evt) {
 478:Src/app_cam.c ****     CAM_IspUpdate();
 479:Src/app_cam.c ****     vTaskDelay(pdMS_TO_TICKS(1));
 480:Src/app_cam.c ****     if (HAL_GetTick() - t0 > timeout_ms) {
 481:Src/app_cam.c ****       if (elapsed_ms) *elapsed_ms = HAL_GetTick() - t0;
 482:Src/app_cam.c ****       return -1;
 483:Src/app_cam.c ****     }
 484:Src/app_cam.c ****   }
 485:Src/app_cam.c ****   if (elapsed_ms) *elapsed_ms = HAL_GetTick() - t0;
 486:Src/app_cam.c ****   return 0;
 487:Src/app_cam.c **** }
 488:Src/app_cam.c **** 
 489:Src/app_cam.c **** void CAM_CountVsyncFrame(void)
 490:Src/app_cam.c **** {
 491:Src/app_cam.c ****   g_vsync_count++;
 492:Src/app_cam.c ****   if (g_wait_frames > 0) {
 493:Src/app_cam.c ****     g_frame_count++;
 494:Src/app_cam.c ****     if (g_frame_count >= (uint32_t)g_wait_frames)
 495:Src/app_cam.c ****       g_wait_frames = 0;
 496:Src/app_cam.c ****   }
 497:Src/app_cam.c **** }
