  42:Src/app_cam.c **** /** Helper: Write a single byte to an IMX335 register via I2C1 (16-bit addr). */
  43:Src/app_cam.c **** static int CAM_WriteSensorReg(uint16_t reg, uint8_t value)
  44:Src/app_cam.c **** {
  45:Src/app_cam.c ****   return CMW_I2C_WRITEREG16(CAMERA_IMX335_ADDRESS, reg, &value, 1);
  46:Src/app_cam.c **** }
