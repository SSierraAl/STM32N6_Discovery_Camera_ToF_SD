 953:Src/app_cam.c **** #if PERF_DEBUG_LEVEL >= 1
 954:Src/app_cam.c ****         printf("[CAM] Frame wait timeout at k=%lu\n", (unsigned long)k);
 955:Src/app_cam.c **** #endif
 956:Src/app_cam.c ****         break;
 957:Src/app_cam.c ****       }
 958:Src/app_cam.c ****       frame_seq++;
 959:Src/app_cam.c **** #if PERF_CAMERA_FRAME_LOG
 960:Src/app_cam.c ****       frame_times[completed_frames++] = frame_ms;
 961:Src/app_cam.c **** #endif
 962:Src/app_cam.c **** 
 963:Src/app_cam.c ****       int32_t out_idx = (int32_t)k - (int32_t)CALLBACK_WARMUP_FRAMES;
 964:Src/app_cam.c ****       if (out_idx >= 0) {
