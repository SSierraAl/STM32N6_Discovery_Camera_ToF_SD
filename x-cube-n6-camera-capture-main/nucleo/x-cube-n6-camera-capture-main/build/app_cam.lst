 847:Src/app_cam.c **** /**
 848:Src/app_cam.c ****  * @brief  Wake from standby, capture CALLBACK_FRAMES continuously, return to standby.
 849:Src/app_cam.c ****  *
 850:Src/app_cam.c ****  *   TRUE zero-copy, no-restart capture. The DCMIPP pipe is Started exactly
 851:Src/app_cam.c ****  *   ONCE for the whole batch and never stopped/restarted. Instead of
 852:Src/app_cam.c ****  *   memcpy-ing each frame out of a scratch buffer (which was measured to
 853:Src/app_cam.c ****  *   cost hundreds of ms per 2.4MB frame — PSRAM-to-PSRAM CPU copies are
 854:Src/app_cam.c ****  *   slow), we reprogram the DCMIPP's own ping-pong destination registers
 855:Src/app_cam.c ****  *   (HAL_DCMIPP_PIPE_SetMemoryAddress) 2 FRAMES AHEAD so the hardware DMAs
 856:Src/app_cam.c ****  *   each wanted frame DIRECTLY into its final batch_buf[] slot. No CPU
 857:Src/app_cam.c ****  *   copy, no race: an address is only ever reprogrammed right after the
 858:Src/app_cam.c ****  *   frame that was using it completes, and that same physical address
 859:Src/app_cam.c ****  *   isn't touched again for a full 2-frame period (~66 ms @30fps) — far
 860:Src/app_cam.c ****  *   longer than a register write takes.
 861:Src/app_cam.c ****  *
 862:Src/app_cam.c ****  *   Sequencing (k = frame index since Start, 0-based):
 863:Src/app_cam.c ****  *     k = 0 .. CALLBACK_WARMUP_FRAMES-1        -> warmup, discarded (lands in
 864:Src/app_cam.c ****  *                                                 capture_buf/save_buf scratch)
 865:Src/app_cam.c ****  *     k = CALLBACK_WARMUP_FRAMES .. (W+N-1)    -> the N=CALLBACK_FRAMES frames
 866:Src/app_cam.c ****  *                                                 we keep, DMA'd straight into
 867:Src/app_cam.c ****  *                                                 batch_buf[k-W]
 868:Src/app_cam.c ****  *   Two frames before each kept frame is due, we redirect whichever
 869:Src/app_cam.c ****  *   physical address is about to free up to point at that frame's final
 870:Src/app_cam.c ****  *   batch_buf slot — so by the time the hardware actually captures it, the
 871:Src/app_cam.c ****  *   destination is already correct.
 872:Src/app_cam.c ****  */
 873:Src/app_cam.c **** int CAM_CallbackBatchSnap(uint8_t *batch_buf, uint32_t frame_size)
