 681:Src/app_cam.c **** /**
 682:Src/app_cam.c ****  * @brief  Wake from standby, capture CALLBACK_FRAMES continuously, return to standby.
 683:Src/app_cam.c ****  *
 684:Src/app_cam.c ****  *   TRUE zero-copy, no-restart capture. The DCMIPP pipe is Started exactly
 685:Src/app_cam.c ****  *   ONCE for the whole batch and never stopped/restarted. Instead of
 686:Src/app_cam.c ****  *   memcpy-ing each frame out of a scratch buffer (which was measured to
 687:Src/app_cam.c ****  *   cost hundreds of ms per 2.4MB frame — PSRAM-to-PSRAM CPU copies are
 688:Src/app_cam.c ****  *   slow), we reprogram the DCMIPP's own ping-pong destination registers
 689:Src/app_cam.c ****  *   (HAL_DCMIPP_PIPE_SetMemoryAddress) 2 FRAMES AHEAD so the hardware DMAs
 690:Src/app_cam.c ****  *   each wanted frame DIRECTLY into its final batch_buf[] slot. No CPU
 691:Src/app_cam.c ****  *   copy, no race: an address is only ever reprogrammed right after the
 692:Src/app_cam.c ****  *   frame that was using it completes, and that same physical address
 693:Src/app_cam.c ****  *   isn't touched again for a full 2-frame period (~66 ms @30fps) — far
 694:Src/app_cam.c ****  *   longer than a register write takes.
 695:Src/app_cam.c ****  *
 696:Src/app_cam.c ****  *   Sequencing (k = frame index since Start, 0-based):
 697:Src/app_cam.c ****  *     k = 0 .. CALLBACK_WARMUP_FRAMES-1        -> warmup, discarded (lands in
 698:Src/app_cam.c ****  *                                                 capture_buf/save_buf scratch)
 699:Src/app_cam.c ****  *     k = CALLBACK_WARMUP_FRAMES .. (W+N-1)    -> the N=CALLBACK_FRAMES frames
 700:Src/app_cam.c ****  *                                                 we keep, DMA'd straight into
 701:Src/app_cam.c ****  *                                                 batch_buf[k-W]
 702:Src/app_cam.c ****  *   Two frames before each kept frame is due, we redirect whichever
 703:Src/app_cam.c ****  *   physical address is about to free up to point at that frame's final
 704:Src/app_cam.c ****  *   batch_buf slot — so by the time the hardware actually captures it, the
 705:Src/app_cam.c ****  *   destination is already correct.
 706:Src/app_cam.c ****  */
 707:Src/app_cam.c **** int CAM_CallbackBatchSnap(uint8_t *batch_buf, uint32_t frame_size)
