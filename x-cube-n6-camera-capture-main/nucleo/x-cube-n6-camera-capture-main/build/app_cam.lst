  43:Inc/perf_debug.h **** /* ================================================================
  44:Inc/perf_debug.h ****    Phase Markers — ordered by typical execution flow
  45:Inc/perf_debug.h ****    ================================================================ */
  46:Inc/perf_debug.h **** 
  47:Inc/perf_debug.h **** typedef enum {
  48:Inc/perf_debug.h ****     PERF_PHASE_START      = 0,   /* Capture cycle begins */
  49:Inc/perf_debug.h ****     PERF_PHASE_CAM_INIT   = 1,   /* Camera sensor + DCMIPP init */
  50:Inc/perf_debug.h ****     PERF_PHASE_CAM_EXPO   = 2,   /* Exposure/gain configuration */
  51:Inc/perf_debug.h ****     PERF_PHASE_CAM_WARMUP = 3,   /* Warmup frame discard */
  52:Inc/perf_debug.h ****     PERF_PHASE_CAM_SNAP   = 4,   /* Final frame acquisition */
  53:Inc/perf_debug.h ****     PERF_PHASE_CAM_STOP   = 5,   /* DCMIPP pipe stop */
  54:Inc/perf_debug.h ****     PERF_PHASE_CAM_DEINIT = 6,   /* Camera deinit */
  55:Inc/perf_debug.h ****     PERF_PHASE_CAM_COPY   = 7,   /* memcpy to save buffer (continuous mode) */
  56:Inc/perf_debug.h ****     PERF_PHASE_CAM_RESTART= 8,   /* DCMIPP pipe restart (continuous mode) */
  57:Inc/perf_debug.h ****     PERF_PHASE_CACHE_CLEAN= 9,   /* D-Cache clean/invalidate ops */
  58:Inc/perf_debug.h ****     PERF_PHASE_SD_READY   = 10,  /* Wait for SD card ready */
  59:Inc/perf_debug.h ****     PERF_PHASE_SD_WRITE   = 11,  /* First blocking HAL SD write */
  60:Inc/perf_debug.h ****     PERF_PHASE_SD_GAP     = 12,  /* Inter-batch gap (min 20ms delay) */
  61:Inc/perf_debug.h ****     PERF_PHASE_STORAGE    = 13,  /* First storage command begins */
  62:Inc/perf_debug.h ****     PERF_PHASE_DONE       = 14,  /* Capture cycle complete */
  63:Inc/perf_debug.h ****     PERF_PHASE_CAM_END    = 15,  /* Camera function returned, before storage queueing */
  64:Inc/perf_debug.h ****     PERF_PHASE_COUNT      = 16
  65:Inc/perf_debug.h **** } PerfPhase_t;
  66:Inc/perf_debug.h **** 
  67:Inc/perf_debug.h **** /* Human-readable phase names */
  68:Inc/perf_debug.h **** extern const char* perf_phase_names[PERF_PHASE_COUNT];
  69:Inc/perf_debug.h **** 
  70:Inc/perf_debug.h **** /* ================================================================
  71:Inc/perf_debug.h ****    Per-capture Timer Structure
  72:Inc/perf_debug.h ****    ================================================================ */
  73:Inc/perf_debug.h **** 
  74:Inc/perf_debug.h **** typedef struct {
  75:Inc/perf_debug.h ****     uint32_t start_tick;                          /* HAL_GetTick() at start */
  76:Inc/perf_debug.h ****     uint32_t phase_ticks[PERF_PHASE_COUNT];       /* tick at each phase mark */
  77:Inc/perf_debug.h ****     uint32_t phase_hit[PERF_PHASE_COUNT];         /* 1 if phase was marked */
  78:Inc/perf_debug.h ****     uint32_t phase_count[PERF_PHASE_COUNT];       /* for repeated phases (SD_WRITE) */
  79:Inc/perf_debug.h **** 
  80:Inc/perf_debug.h ****     /* SD-specific counters (when PERF_TRACK_SD_WAIT_TIME) */
  81:Inc/perf_debug.h ****     uint32_t sd_total_wait_ms;                    /* cumulative time waiting for card ready */
  82:Inc/perf_debug.h ****     uint32_t sd_total_write_ms;                   /* cumulative time in HAL_SD_WriteBlocks */
  83:Inc/perf_debug.h ****     uint32_t sd_total_gap_ms;                     /* cumulative inter-batch gap time */
  84:Inc/perf_debug.h ****     uint32_t sd_batch_count;                      /* number of SD batches written */
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\ccnpdmuN.s 			page 13


  85:Inc/perf_debug.h ****     uint32_t sd_max_batch_ms;                     /* slowest single batch write */
  86:Inc/perf_debug.h ****     uint32_t sd_max_wait_ms;                      /* longest single card-ready wait */
  87:Inc/perf_debug.h ****     uint32_t sd_blocks_written;                   /* successful HAL calls, includes retry traffic *
  88:Inc/perf_debug.h ****     uint32_t storage_wall_ms;                     /* all storage commands, including retries */
  89:Inc/perf_debug.h ****     uint32_t storage_frames;                      /* successfully saved frames */
  90:Inc/perf_debug.h ****     uint32_t storage_failures;                    /* commands that failed after recovery */
  91:Inc/perf_debug.h ****     uint32_t sd_checksum_ms; /* subset of storage remaining work */
