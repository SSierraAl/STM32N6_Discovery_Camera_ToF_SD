   1:Inc/perf_debug.h **** /**
   2:Inc/perf_debug.h ****  * ******************************************************************************
   3:Inc/perf_debug.h ****  * @file    perf_debug.h
   4:Inc/perf_debug.h ****  * @brief   Performance Debug Framework — Granular Timing + Bottleneck Analysis
   5:Inc/perf_debug.h ****  *
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\cc3ICE2n.s 			page 8


   6:Inc/perf_debug.h ****  *   PURPOSE:
   7:Inc/perf_debug.h ****  *     Replace scattered printf() timing with a structured, configurable
   8:Inc/perf_debug.h ****  *     debug system that identifies where time is spent during capture:
   9:Inc/perf_debug.h ****  *       - Camera init (sensor detect, I2C config, DCMIPP setup)
  10:Inc/perf_debug.h ****  *       - Camera capture (exposure/gain, warmup frames, frame acquisition)
  11:Inc/perf_debug.h ****  *       - Camera deinit (pipe stop, deinit)
  12:Inc/perf_debug.h ****  *       - SD storage (card ready wait, batch writes, inter-batch gaps)
  13:Inc/perf_debug.h ****  *     Then print a clear summary with bottleneck identification.
  14:Inc/perf_debug.h ****  *
  15:Inc/perf_debug.h ****  *   Timer ownership: Capture_RequestSnapshot starts/stops the cycle timer.
  16:Inc/perf_debug.h ****  *   Camera and storage tasks add markers/counters before giving completion
  17:Inc/perf_debug.h ****  *   semaphores. Markers retain their FIRST occurrence; phase_count records
  18:Inc/perf_debug.h ****  *   repeated hits. SD wall time is accumulated separately for every command.
  19:Inc/perf_debug.h ****  *
  20:Inc/perf_debug.h ****  *   DEBUG LEVELS (controlled by PERF_DEBUG_LEVEL in app_config.h):
  21:Inc/perf_debug.h ****  *     0 = Production: only final total time
  22:Inc/perf_debug.h ****  *     1 = Standard: phase breakdown percentages
  23:Inc/perf_debug.h ****  *     2 = Verbose: sub-phase timing + per-batch SD info (throttled)
  24:Inc/perf_debug.h ****  *     3 = Debug: everything + raw counters + wait-state details
  25:Inc/perf_debug.h ****  *
  26:Inc/perf_debug.h ****  * ******************************************************************************
  27:Inc/perf_debug.h ****  */
  28:Inc/perf_debug.h **** 
  29:Inc/perf_debug.h **** #ifndef PERF_DEBUG_H
  30:Inc/perf_debug.h **** #define PERF_DEBUG_H
  31:Inc/perf_debug.h **** 
  32:Inc/perf_debug.h **** #include <stdint.h>
  33:Inc/perf_debug.h **** #include <stdio.h>
  34:Inc/perf_debug.h **** #include <string.h>
  35:Inc/perf_debug.h **** #include <inttypes.h>
  36:Inc/perf_debug.h **** #include "stm32n6xx_hal.h"
  37:Inc/perf_debug.h **** #include "app_config.h"
  38:Inc/perf_debug.h **** 
  39:Inc/perf_debug.h **** #if !defined(PERF_REPORT_DETAIL) || !defined(PERF_PRINT_SUMMARY)
  40:Inc/perf_debug.h **** #error "Restore PERF_PRINT_SUMMARY and PERF_REPORT_DETAIL in app_config.h"
  41:Inc/perf_debug.h **** #endif
  42:Inc/perf_debug.h **** 
  43:Inc/perf_debug.h **** /* ================================================================
  44:Inc/perf_debug.h ****    Phase Markers — ordered by typical execution flow
  45:Inc/perf_debug.h ****    ================================================================ */
  46:Inc/perf_debug.h **** 
  47:Inc/perf_debug.h **** typedef enum {
  48:Inc/perf_debug.h ****     PERF_PHASE_START      = 0,   /* Capture cycle begins */
  49:Inc/perf_debug.h ****     PERF_PHASE_CAM_INIT   = 1,   /* Camera sensor + DCMIPP init */
  50:Inc/perf_debug.h ****     PERF_PHASE_CAM_EXPO   = 2,   /* Exposure/gain configuration */
  51:Inc/perf_debug.h ****     PERF_PHASE_CAM_WARMUP = 3,   /* Warmup frame discard */
  52:Inc/perf_debug.h ****     PERF_PHASE_CAM_SNAP   = 4,   /* Final frame acquisition */
  53:Inc/perf_debug.h ****     PERF_PHASE_CAM_STOP   = 5,   /* DCMIPP pipe stop */
  54:Inc/perf_debug.h ****     PERF_PHASE_CAM_DEINIT = 6,   /* Camera deinit */
  55:Inc/perf_debug.h ****     PERF_PHASE_CAM_COPY   = 7,   /* memcpy to save buffer (continuous mode) */
  56:Inc/perf_debug.h ****     PERF_PHASE_CAM_RESTART= 8,   /* DCMIPP pipe restart (continuous mode) */
  57:Inc/perf_debug.h ****     PERF_PHASE_CACHE_CLEAN= 9,   /* D-Cache clean/invalidate ops */
  58:Inc/perf_debug.h ****     PERF_PHASE_SD_READY   = 10,  /* Wait for SD card ready */
  59:Inc/perf_debug.h ****     PERF_PHASE_SD_WRITE   = 11,  /* First blocking HAL SD write */
  60:Inc/perf_debug.h ****     PERF_PHASE_SD_GAP     = 12,  /* Inter-batch gap (min 20ms delay) */
  61:Inc/perf_debug.h ****     PERF_PHASE_STORAGE    = 13,  /* First storage command begins */
  62:Inc/perf_debug.h ****     PERF_PHASE_DONE       = 14,  /* Capture cycle complete */
ARM GAS  C:\Users\ssierra\AppData\Local\Temp\cc3ICE2n.s 			page 9


  63:Inc/perf_debug.h ****     PERF_PHASE_CAM_END    = 15,  /* Camera function returned, before storage queueing */
  64:Inc/perf_debug.h ****     PERF_PHASE_COUNT      = 16
  65:Inc/perf_debug.h **** } PerfPhase_t;
  66:Inc/perf_debug.h **** 
  67:Inc/perf_debug.h **** /* Human-readable phase names */
  68:Inc/perf_debug.h **** extern const char* perf_phase_names[PERF_PHASE_COUNT];
  69:Inc/perf_debug.h **** 
  70:Inc/perf_debug.h **** /* ================================================================
  71:Inc/perf_debug.h ****    Per-capture Timer Structure
  72:Inc/perf_debug.h ****    ================================================================ */
  73:Inc/perf_debug.h **** 
  74:Inc/perf_debug.h **** typedef struct {
  75:Inc/perf_debug.h ****     uint32_t start_tick;                          /* HAL_GetTick() at start */
  76:Inc/perf_debug.h ****     uint32_t phase_ticks[PERF_PHASE_COUNT];       /* tick at each phase mark */
  77:Inc/perf_debug.h ****     uint32_t phase_hit[PERF_PHASE_COUNT];         /* 1 if phase was marked */
  78:Inc/perf_debug.h ****     uint32_t phase_count[PERF_PHASE_COUNT];       /* for repeated phases (SD_WRITE) */
  79:Inc/perf_debug.h **** 
  80:Inc/perf_debug.h ****     /* SD-specific counters (when PERF_TRACK_SD_WAIT_TIME) */
  81:Inc/perf_debug.h ****     uint32_t sd_total_wait_ms;                    /* cumulative time waiting for card ready */
  82:Inc/perf_debug.h ****     uint32_t sd_total_write_ms;                   /* cumulative time in HAL_SD_WriteBlocks */
  83:Inc/perf_debug.h ****     uint32_t sd_total_gap_ms;                     /* cumulative inter-batch gap time */
  84:Inc/perf_debug.h ****     uint32_t sd_batch_count;                      /* number of SD batches written */
  85:Inc/perf_debug.h ****     uint32_t sd_max_batch_ms;                     /* slowest single batch write */
  86:Inc/perf_debug.h ****     uint32_t sd_max_wait_ms;                      /* longest single card-ready wait */
  87:Inc/perf_debug.h ****     uint32_t sd_blocks_written;                   /* successful HAL calls, includes retry traffic *
  88:Inc/perf_debug.h ****     uint32_t storage_wall_ms;                     /* all storage commands, including retries */
  89:Inc/perf_debug.h ****     uint32_t storage_frames;                      /* successfully saved frames */
  90:Inc/perf_debug.h ****     uint32_t storage_failures;                    /* commands that failed after recovery */
  91:Inc/perf_debug.h ****     uint32_t sd_checksum_ms; /* subset of storage remaining work */
  92:Inc/perf_debug.h ****     uint64_t payload_bytes;                       /* successful image payloads only */
  93:Inc/perf_debug.h **** 
  94:Inc/perf_debug.h **** } PerfTimer_t;
  95:Inc/perf_debug.h **** 
  96:Inc/perf_debug.h **** /* ================================================================
  97:Inc/perf_debug.h ****    Running Statistics (when PERF_STATS_WINDOW > 0)
  98:Inc/perf_debug.h ****    ================================================================ */
  99:Inc/perf_debug.h **** 
 100:Inc/perf_debug.h **** typedef struct {
 101:Inc/perf_debug.h ****     uint32_t total_times[PERF_STATS_WINDOW > 0 ? PERF_STATS_WINDOW : 1];
 102:Inc/perf_debug.h ****     uint32_t cam_times[PERF_STATS_WINDOW > 0 ? PERF_STATS_WINDOW : 1];
 103:Inc/perf_debug.h ****     uint32_t sd_times[PERF_STATS_WINDOW > 0 ? PERF_STATS_WINDOW : 1];
 104:Inc/perf_debug.h ****     uint32_t count;
 105:Inc/perf_debug.h ****     uint32_t index;
 106:Inc/perf_debug.h **** } PerfStats_t;
 107:Inc/perf_debug.h **** 
 108:Inc/perf_debug.h **** extern PerfStats_t g_perf_stats;
