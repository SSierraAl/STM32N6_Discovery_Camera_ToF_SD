 979:Src/app_cam.c ****         HAL_DCMIPP_PIPE_SetMemoryAddress(h, DCMIPP_PIPE1,
 980:Src/app_cam.c ****                                           parity == 0U ? DCMIPP_MEMORY_ADDRESS_0 : DCMIPP_MEMORY_AD
 981:Src/app_cam.c ****                                           (uint32_t)(batch_buf + ((uint32_t)arm_idx * frame_size)))
 982:Src/app_cam.c ****       }
 983:Src/app_cam.c ****     }
