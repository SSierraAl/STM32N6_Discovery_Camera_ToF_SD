 281:Src/app_cam.c ****     case CMW_IMX335_Sensor:    mode = SENSOR_IMX335_FLIP; idx = 2; break;
 282:Src/app_cam.c ****     case CMW_VD55G1_Sensor:    mode = SENSOR_VD55G1_FLIP; idx = 3; break;
 283:Src/app_cam.c ****     case CMW_VD1943_Sensor:    mode = SENSOR_VD1943_FLIP; idx = 4; break;
 284:Src/app_cam.c ****     default: assert(0);
 285:Src/app_cam.c ****   }
 286:Src/app_cam.c ****   printf("Detected %s\n", sensor_names[idx]);
 287:Src/app_cam.c ****   return mode;
