 292:Src/app_cam.c **** }
 293:Src/app_cam.c **** 
 294:Src/app_cam.c **** /**
 295:Src/app_cam.c ****  * @brief  Block until DCMIPP confirms a full frame has been DMA'd into
 296:Src/app_cam.c ****  *         capture_buf (CMW_CAMERA_PIPE_FrameEventCallback -> CAM_NotifyFrameEvent).
 297:Src/app_cam.c ****  *
 298:Src/app_cam.c ****  *   IMPORTANT: This must gate ONLY on the frame-complete event, not VSYNC.
 299:Src/app_cam.c ****  *   VSYNC marks the START of the next frame (sensor row-sync) and can fire
 300:Src/app_cam.c ****  *   slightly before DCMIPP finishes writing the previous frame to PSRAM.
 301:Src/app_cam.c ****  *   Gating on "vsync OR frame_event" (as before) could let the caller stop
 302:Src/app_cam.c ****  *   the pipe and memcpy a frame that is still being written -> partial/black
 303:Src/app_cam.c ****  *   or torn images, worse for a moving subject.
 304:Src/app_cam.c ****  * @return 0 on success, -1 on timeout (elapsed_ms optionally reports actual wait)
 305:Src/app_cam.c ****  */
 306:Src/app_cam.c **** static int CAM_WaitNextFrameReady(uint32_t timeout_ms, uint32_t *elapsed_ms)
 307:Src/app_cam.c **** {
 308:Src/app_cam.c ****   uint32_t start_evt = g_frame_event_count;
 309:Src/app_cam.c ****   uint32_t t0 = HAL_GetTick();
 310:Src/app_cam.c **** 
 311:Src/app_cam.c ****   while (g_frame_event_count == start_evt) {
 312:Src/app_cam.c ****     CAM_IspUpdate();
 313:Src/app_cam.c ****     vTaskDelay(1);   /* 1 tick = 10 ms with configTICK_RATE_HZ=100 */
 314:Src/app_cam.c ****     if (HAL_GetTick() - t0 > timeout_ms) {
 315:Src/app_cam.c ****       if (elapsed_ms) *elapsed_ms = HAL_GetTick() - t0;
 316:Src/app_cam.c ****       return -1;
 317:Src/app_cam.c ****     }
 318:Src/app_cam.c ****   }
 319:Src/app_cam.c ****   if (elapsed_ms) *elapsed_ms = HAL_GetTick() - t0;
 320:Src/app_cam.c ****   return 0;
 321:Src/app_cam.c **** }
 322:Src/app_cam.c **** 
 323:Src/app_cam.c **** void CAM_CountVsyncFrame(void)
 324:Src/app_cam.c **** {
 325:Src/app_cam.c ****   g_vsync_count++;
 326:Src/app_cam.c ****   if (g_wait_frames > 0) {
 327:Src/app_cam.c ****     g_frame_count++;
 328:Src/app_cam.c ****     if (g_frame_count >= (uint32_t)g_wait_frames)
 329:Src/app_cam.c ****       g_wait_frames = 0;
 330:Src/app_cam.c ****   }
 331:Src/app_cam.c **** }
 332:Src/app_cam.c **** 
 333:Src/app_cam.c **** void CAM_ResetFrameCounter(int wait_frames)
 334:Src/app_cam.c **** {
 335:Src/app_cam.c ****   g_frame_count = 0;
 336:Src/app_cam.c ****   g_wait_frames = wait_frames;
 337:Src/app_cam.c **** }
