  42:Src/app_cvt.c **** 
  43:Src/app_cvt.c **** #define RGB_2_Y(r, g, b, y) do { \
  44:Src/app_cvt.c ****   y = CVT_RED_Y_LUT[r] + CVT_GREEN_Y_LUT[g] + CVT_BLUE_Y_LUT[b]; \
  45:Src/app_cvt.c ****   CLAMP(y, 0, 255); \
  46:Src/app_cvt.c **** } while(0)
