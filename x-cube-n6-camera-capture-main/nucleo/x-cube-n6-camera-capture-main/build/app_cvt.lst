  58:Src/app_cvt.c **** __STATIC_FORCEINLINE void CVT_DualPelRgbToYuv(uint8_t *r, uint8_t *g, uint8_t *b, int32_t *y, int32
  59:Src/app_cvt.c **** {
  60:Src/app_cvt.c ****   uint8_t red, green, blue;
  61:Src/app_cvt.c **** 
  62:Src/app_cvt.c ****   RGB_2_Y(r[0], g[0], b[0], y[0]);
  63:Src/app_cvt.c ****   RGB_2_Y(r[1], g[1], b[1], y[1]);
  64:Src/app_cvt.c **** 
  65:Src/app_cvt.c ****   red = (r[0] + r[1] + 1) / 2;
  66:Src/app_cvt.c ****   green = (g[0] + g[1] + 1) / 2;
  67:Src/app_cvt.c ****   blue = (b[0] + b[1] + 1) / 2;
  68:Src/app_cvt.c **** 
  69:Src/app_cvt.c ****   RGB_2_CR(red, green, blue, cr[0]);
  70:Src/app_cvt.c ****   RGB_2_CB(red, green, blue, cb[0]);
  71:Src/app_cvt.c **** }
